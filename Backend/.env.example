# ==============================================================================
# Imposter Game Backend - Environment Configuration Template
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Imposter?retryWrites=true&w=majority

# Redis Connection URL
REDIS_URL=rediss://default:<password>@<host>:6379

# ==============================================================================
# Redis Key Expiration (TTL) & Timeout Configuration (in seconds)
# ==============================================================================
# Active room state expiration (default: 86400s = 24 hours)
REDIS_ROOM_TTL=86400

# Player-to-room mapping expiration (default: 86400s = 24 hours)
REDIS_PLAYER_ROOM_TTL=86400

# Socket-to-player bidirectional mapping expiration (default: 86400s = 24 hours)
REDIS_SOCKET_MAPPING_TTL=86400

# Voice chat participants hash key expiration (default: 86400s = 24 hours)
REDIS_VOICE_PARTICIPANTS_TTL=86400

# Pending rejoin request expiration (default: 45s)
REDIS_REJOIN_REQUEST_TTL=45

# Safety expiration buffer added to phase and disconnect timer keys (default: 10s)
REDIS_TIMER_BUFFER_TTL=10

# Default fallback timeout for lobby disconnect countdown (default: 5s)
REDIS_LOBBY_DISCONNECT_TIMEOUT=5

# Default fallback timeout for in-game disconnect grace period (default: 30s)
REDIS_GAME_DISCONNECT_TIMEOUT=30

# Default fallback timeout for turn timer key (default: 30s)
REDIS_TURN_TIMER_TIMEOUT=30

# Default fallback timeout for voting timer key (default: 45s)
REDIS_VOTING_TIMER_TIMEOUT=45

# Authentication & Security
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=50m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_at_least_32_characters_long
REFRESH_TOKEN_EXPIRES_IN=30d

# Admin Credentials
ADMIN_EMAIL=admin@imposter.game
ADMIN_PASSWORD=AdminSecret123!
